# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Snowflake
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=ECON_AGENT_DB
SNOWFLAKE_SCHEMA=ANALYTICS
# Use a role with USAGE + SELECT only. ACCOUNTADMIN works for local testing,
# but it is not read-only.
SNOWFLAKE_ROLE=

# Optional: only needed if your account uses a programmatic access token (PAT)
# instead of a password. Put the PAT in SNOWFLAKE_PASSWORD above.
# SNOWFLAKE_AUTHENTICATOR=PROGRAMMATIC_ACCESS_TOKEN

# Optional: existing project objects (the defaults shown are used if omitted)
# SNOWFLAKE_TABLE=ECON_AGENT_DB.ANALYTICS.ECONOMIC_DASHBOARD_LIVE
# SNOWFLAKE_SEMANTIC_VIEW=ECON_AGENT_DB.ANALYTICS.ECONOMIC_DASHBOARD_SEMANTIC
# MAX_RESULT_ROWS=200
# QUERY_TIMEOUT_SECONDS=60
